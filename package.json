{
  "name": "farflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/client",
    "packages/ui",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @farflow/web --",
    "build": "npm run build --workspace @farflow/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "desktop:dev": "npm run dev --workspace @farflow/desktop",
    "desktop:build": "npm run build --workspace @farflow/desktop"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
